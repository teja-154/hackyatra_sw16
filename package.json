{
  "name": "coc-sync",
  "version": "1.0.0",
  "private": true,
  "description": "City Operations Center — Real-Time Civic Alert Integration",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
